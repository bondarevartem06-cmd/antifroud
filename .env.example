# Скопируйте этот файл в .env и задайте свои пароли. Файл .env в репозиторий не попадает (см. .gitignore).
# Пароли: только латинские буквы и цифры (без $ # кавычек и пробелов).
POSTGRES_USER=antifraud
POSTGRES_PASSWORD=change_me_to_a_long_random_password
POSTGRES_DB=antifraud

# Airflow (веб-интерфейс http://localhost:8081)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_password

# Компактная языковая модель Ollama для резюме (скачивается при первом запуске, около 2 ГБ)
OLLAMA_MODEL=qwen2.5:3b
